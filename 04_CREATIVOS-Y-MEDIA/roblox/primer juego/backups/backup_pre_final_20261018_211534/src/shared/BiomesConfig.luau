function BiomesConfig.GetBiomeById(id: number): BiomeInfo?
	return BiomesConfig.Biomes[id]
end

function BiomesConfig.GetBiomeByEgg(eggType: string): BiomeInfo?
	for _, b in ipairs(BiomesConfig.Biomes) do
		if b.EggTemplate == eggType or b.CapsuleName == eggType then
			return b
		end
	end
	return BiomesConfig.Biomes[1]
end

return BiomesConfig

